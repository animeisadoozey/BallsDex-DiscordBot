+
+        await interaction.response.defer(ephemeral=True, thinking=True)
+
+        player, _ = await Player.get_or_create(discord_id=interaction.user.id)
+        query = BallInstance.filter(
+            player=player,
+            special_id__isnull=True,
+            ball_id=token_ball.pk,
+        )
