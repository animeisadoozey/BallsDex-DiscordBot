+            "Are you sure you want to clear your proposal?", view=view, ephemeral=True
+        )
+        await view.wait()
+        if not view.value:
+            return
+
+        if battler.locked:
+            await interaction.followup.send(
+                "You have locked your proposal, it cannot be edited! "
